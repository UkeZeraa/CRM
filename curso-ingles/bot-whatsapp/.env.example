# ===== WhatsApp Cloud API (Meta) =====
# Token de acesso permanente (System User) do app no Meta for Developers
WHATSAPP_TOKEN=
# ID do número de telefone (WhatsApp > Configuração da API)
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete na configuração do webhook no painel da Meta
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-secreto
# Chave secreta do app (Configurações do app > Básico) — valida a assinatura dos webhooks
WHATSAPP_APP_SECRET=
# Versão da Graph API (veja a mais recente no painel da Meta)
GRAPH_API_VERSION=v23.0
# Modelo aprovado (categoria Utilidade) usado quando o aluno não fala com o bot há mais de 24h
WHATSAPP_TEMPLATE_NAME=quiz_ingles_diario
WHATSAPP_TEMPLATE_LANG=pt_BR

# ===== Alunos =====
# Números com DDI+DDD, só dígitos, separados por vírgula. Só esses números podem usar o bot.
ALUNOS=5511999999999
# Data em que o curso começou (AAAA-MM-DD). Define o mês/semana do currículo.
INICIO_CURSO=2026-11-10

# ===== Agenda =====
FUSO_HORARIO=America/Sao_Paulo
JANELA_INICIO=08:00
JANELA_FIM=17:00
QUIZZES_MIN_DIA=2
QUIZZES_MAX_DIA=3
# Intervalo mínimo entre dois quizzes (minutos)
INTERVALO_MINIMO_MIN=120
PERGUNTAS_POR_QUIZ=5

# ===== Claude (gera e corrige os quizzes) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = respostas rápidas e baratas; suba para medium/high se quiser correções mais elaboradas
CLAUDE_EFFORT=low

# ===== Servidor =====
PORT=3000
ARQUIVO_ESTADO=./data/estado.json
# 1 = não envia nada para a Meta, só imprime no terminal (para testes)
DRY_RUN=0
